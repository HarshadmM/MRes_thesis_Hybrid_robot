
#define X_STEP_PIN 54
#define X_DIR_PIN 55
#define X_EN_PIN 38

#define Y_STEP_PIN 60
#define Y_DIR_PIN 61
#define Y_EN_PIN 56

#define Z_STEP_PIN 46
#define Z_DIR_PIN 48
#define Z_EN_PIN 62

#define E0_STEP_PIN 26
#define E0_DIR_PIN 28
#define E0_ENABLE_PIN 24

int stepDelay = 700;

char xCmd = 'S';
char yCmd = 'W';
char zCmd = 'N';
char e0Cmd = 'H';

unsigned long lastXStep = 0;
unsigned long lastYStep = 0;
unsigned long lastZStep = 0;
unsigned long lastE0Step = 0;

void setup() {
  Serial.begin(115200);

  pinMode(X_STEP_PIN, OUTPUT);
  pinMode(X_DIR_PIN, OUTPUT);
  pinMode(X_EN_PIN, OUTPUT);

  pinMode(Y_STEP_PIN, OUTPUT);
  pinMode(Y_DIR_PIN, OUTPUT);
  pinMode(Y_EN_PIN, OUTPUT);

  pinMode(Z_STEP_PIN, OUTPUT);
  pinMode(Z_DIR_PIN, OUTPUT);
  pinMode(Z_EN_PIN, OUTPUT);

  pinMode(E0_STEP_PIN, OUTPUT);
  pinMode(E0_DIR_PIN, OUTPUT);
  pinMode(E0_ENABLE_PIN, OUTPUT);

  // Enable/disable stepper drivers
  digitalWrite(X_EN_PIN, LOW);
  digitalWrite(Y_EN_PIN, LOW);
  digitalWrite(Z_EN_PIN, HIGH);
  digitalWrite(E0_ENABLE_PIN, LOW);
}

void loop() {
  readSerialCommands();

  runMotorX();
  runMotorY();
  runMotorZ();
  runMotorE0();
}

void readSerialCommands() {
  while (Serial.available()) {
    char c = Serial.read();

    // X motor
    if (c == 'U' || c == 'D' || c == 'S') {
      xCmd = c;
    }

    // Y motor
    else if (c == 'R' || c == 'L' || c == 'W') {
      yCmd = c;
    }

    // Z motor
    else if (c == 'P') {
      zCmd = 'P';
      digitalWrite(Z_EN_PIN, LOW);
    }

    else if (c == 'N') {
      zCmd = 'N';
      digitalWrite(Z_EN_PIN, HIGH);
    }

    // E0 motor
    else if (c == 'F' || c == 'B' || c == 'H') {
      e0Cmd = c;
    }

    // Speed control
    else if (c == 'V') {
      int newSpeed = Serial.parseInt();

      if (newSpeed >= 150 && newSpeed <= 5000) {
        stepDelay = newSpeed;
      }
    }

    // Placeholder commands
    else if (c == 'T') {
      Serial.println("Tare ignored");
    }

    else if (c == 'Z') {
      Serial.println("Zero ignored");
    }

    // Telemetry
    else if (c == 'Q') {
      Serial.println("# LIVE\t0\t0\t0\t0\t0\t0");
    }
  }
}

void runMotorX() {
  if (xCmd == 'S') return;

  digitalWrite(X_DIR_PIN, xCmd == 'U' ? HIGH : LOW);

  if (micros() - lastXStep >= (unsigned long)stepDelay) {
    stepOnce(X_STEP_PIN);
    lastXStep = micros();
  }
}

void runMotorY() {
  if (yCmd == 'W') return;

  digitalWrite(Y_DIR_PIN, yCmd == 'R' ? HIGH : LOW);

  if (micros() - lastYStep >= (unsigned long)stepDelay) {
    stepOnce(Y_STEP_PIN);
    lastYStep = micros();
  }
}

void runMotorZ() {
  if (zCmd == 'N') return;

  digitalWrite(Z_DIR_PIN, HIGH);

  if (micros() - lastZStep >= (unsigned long)stepDelay) {
    stepOnce(Z_STEP_PIN);
    lastZStep = micros();
  }
}

void runMotorE0() {
  if (e0Cmd == 'H') return;

  digitalWrite(E0_DIR_PIN, e0Cmd == 'F' ? HIGH : LOW);

  if (micros() - lastE0Step >= (unsigned long)stepDelay) {
    stepOnce(E0_STEP_PIN);
    lastE0Step = micros();
  }
}

void stepOnce(int stepPin) {
  digitalWrite(stepPin, HIGH);
  delayMicroseconds(3);
  digitalWrite(stepPin, LOW);
}
